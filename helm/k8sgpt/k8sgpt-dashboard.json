{
    "dashboard": {
        "title": "K8sGPT Overview",
        "tags": [
            "k8sgpt",
            "kubernetes",
            "ai"
        ],
        "timezone": "browser",
        "schemaVersion": 36,
        "refresh": "30s",
        "panels": [
            {
                "id": 1,
                "title": "Analysis Results Count",
                "type": "stat",
                "targets": [
                    {
                        "expr": "count(k8sgpt_results)",
                        "legendFormat": "Total Issues",
                        "datasource": "Prometheus"
                    }
                ],
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 0
                }
            },
            {
                "id": 2,
                "title": "Issues by Kind",
                "type": "piechart",
                "targets": [
                    {
                        "expr": "count by (kind) (k8sgpt_results)",
                        "legendFormat": "{{kind}}",
                        "datasource": "Prometheus"
                    }
                ],
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 0
                }
            },
            {
                "id": 3,
                "title": "K8sGPT Analysis Duration",
                "type": "graph",
                "targets": [
                    {
                        "expr": "histogram_quantile(0.95, sum(rate(k8sgpt_analysis_duration_seconds_bucket[5m])) by (le))",
                        "legendFormat": "p95 Duration",
                        "datasource": "Prometheus"
                    }
                ],
                "gridPos": {
                    "h": 8,
                    "w": 24,
                    "x": 0,
                    "y": 8
                }
            }
        ]
    }
}